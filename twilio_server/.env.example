# GPT-Live migration settings. Merge these into your EXISTING server environment.
# Do not replace existing credentials with this file.
MODEL=gpt-live-1
VOICE=marin
LIVE_BACKEND_MODEL=gpt-5.6-luna

# Optional style input. Omit to use the full built-in American conversational
# prompt. Overrides delivery wording only; role and call policies stay in place.
# VOICE_STYLE="Use General American English with a warm, relaxed conversational pace, natural pauses, and concise everyday phrasing."

# Optional: change only if the public hostname for outbound callbacks differs.
PUBLIC_BASE_URL=https://twillio-ai-assistant.onrender.com

# Keep existing OPENAI_API_KEY, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
# TWILIO_FROM_NUMBER, REDIS_URL, MONGO_URI, MONGO_DB_NAME,
# MONGO_COLLECTION_NAME, and PORT. Email (SMTP_*) and Discord (DISCORD_*)
# settings are needed only by the worker, deployed from pythonserver/.

# Optional spam and spoofing screening for inbound calls (see README).
# SCREENING_LOOKUP=1            # 0 turns off the paid Twilio reverse lookup
# IPQS_API_KEY=                 # IPQualityScore key for spam reputation
# SCREENING_OWN_NUMBERS=        # other numbers a caller ID must not show, comma-separated
# SCREENING_REPORT_ALL=         # 1 reports every inbound call to Discord, not just risky ones
